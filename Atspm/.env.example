# Copy this file to .env beside docker-compose.yml, then fill every blank value.
# This Compose configuration is for local development and evaluation.
# Keep the completed .env private; it is ignored by Git.

POSTGRES_USER=atspm
POSTGRES_PASSWORD=

# A strong password with an uppercase letter, lowercase letter, number, and symbol.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
ADMIN_ROLE=Admin
SEED_ADMIN=true

# Use a random key of at least 32 bytes (for example, `openssl rand -hex 32`).
JWT_KEY=
JWT_ISSUER=ATSPM-local
JWT_EXPIRE_DAYS=1

# Password used when exporting nginx/certs/aspnetapp.pfx.
CERT_PASSWORD=

# These are development defaults. Override per-context DatabaseConfiguration__...
# variables only when connecting to a different database server/provider.
ALLOWED_HOSTS=*

# Optional: see README for the certificate mount and WatchDog time zone.
# CERT_LOCATION=./nginx/certs:/app/certs:ro
# WatchdogConfiguration__TimeZoneId=America/Denver
